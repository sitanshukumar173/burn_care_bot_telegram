# From @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini models to try in order (comma-separated); later ones are used when the first is overloaded
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3-flash-preview,gemini-flash-latest

# Shown in emergency messages (defaults are for India)
EMERGENCY_NUMBERS=112 (emergency) / 108 (ambulance)

# OpenStreetMap asks for an identifying User-Agent; include a contact if you can
OSM_USER_AGENT=BurnCareTelegramBot/1.0
